{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RadiVision AI - Desktop GUI (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "RadiVision AI - FastAPI Backend (server.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Evaluate Chest Model (90.72%)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/model/chest/evaluate_chest.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Evaluate Bone Model (91.40%)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/model/bone/evaluate_bone.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
