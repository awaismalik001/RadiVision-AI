{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RadiVision AI (Run App)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Evaluate Chest Model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/model/chest/evaluate_chest.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Evaluate Bone Model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/model/bone/evaluate_bone.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
