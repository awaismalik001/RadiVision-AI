# RadiVision AI Environment Template
# Duplicate this file as .env and populate with your production API keys

# 1. Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Maps / Places API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. AES-256 Secret Key (32 bytes base64-encoded)
AES_SECRET_KEY=your_aes_secret_key_base64_here

# 4. Server Host & Port Settings
HOST=127.0.0.1
PORT=8000
